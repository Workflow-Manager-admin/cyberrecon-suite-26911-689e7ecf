{
  "task_description": "{'component_name': 'Main Container for CyberRecon Suite', 'description': "Primary container for CyberRecon Suite implementation: Cybersuite Recon is a cross-platform cybersecurity desktop tool inspired by Burp Suite, focused on recon, scanning, exploitation, and reporting. Built with React.js and Electron, it features a modular, accessible, dark-themed tabbed UI. The tool integrates CLI utilities (Amass, Masscan, Nuclei), a built-in proxy, JS/DOM analysis, wordlist generation, markdown reporting, bug bounty aggregation, and plugin management. It is designed for offline use, with local SQLite caching, secure IPC, and robust error handling. The UI is polished, fast, and mimics Burp Suite's workflow, ensuring a professional experience for security professionals.", 'framework': 'react', 'platform': 'web', 'container': '{\n  "name": "ColorCraft frontend Container",\n  "features": [\n    {\n      "name": "Recon Dashboard",\n      "description": "Input domains, run Amass and Masscan via Electron backend, visualize results in graph/table, export to CSV/JSON, and cache recon history in SQLite.",\n      "isEnabled": true\n    },\n    {\n      "name": "Vulnerability Scanner",\n      "description": "Integrate Nuclei CLI for vulnerability scanning (XSS, SQLi, etc.), filter templates, display findings, generate PoC snippets, and export results.",\n      "isEnabled": true\n    },\n    {\n      "name": "Exploitation Toolkit",\n      "description": "Built-in proxy with start/stop, dual-pane request/response viewer, replay modified requests, JWT/Base64 decoder, and session timeline.",\n      "isEnabled": true\n    },\n    {\n      "name": "JS Debugger",\n      "description": "Paste/upload JS/HTML, extract secrets/tokens/endpoints using regex, and display results in a live-updating table.",\n      "isEnabled": true\n    },\n    {\n      "name": "Wordlist Generator",\n      "description": "Paste/upload JS/HTML, run TF-IDF analysis in-browser, and export high-priority keywords for use in attacks.",\n      "isEnabled": true\n    },\n    {\n      "name": "Report Generator",\n      "description": "Markdown editor with live preview, screenshot uploads, auto-insert findings, and export to PDF/HTML.",\n      "isEnabled": true\n    },\n    {\n      "name": "Bug Bounty Aggregator",\n      "description": "Fetch programs from HackerOne, Bugcrowd, Intigriti, filter by bounty/platform, and add domains to Recon module.",\n      "isEnabled": true\n    },\n    {\n      "name": "Settings/Plugin Manager",\n      "description": "Configure API keys, proxy settings, and manage optional plugins (CVE tools, payload generators).",\n      "isEnabled": true\n    }\n  ],\n  "techStack": {\n    "frontend": [\n      "React JS"\n    ],\n    "backend": [\n      "None"\n    ],\n    "language": [\n      "JavaScript (ES6+)"\n    ]\n  },\n  "colors": {\n    "primary": "#1a1a1a",\n    "secondary": "#23272e",\n    "accent": "#ff9800"\n  },\n  "theme": "light",\n  "layoutDescription": "The UI uses a dark, Burp Suite-inspired theme with a persistent left sidebar for module navigation (Recon, Scanner, Exploitation, JS Debugger, Wordlist, Reports, Bounty, Settings). Each module opens in a main tabbed workspace. Recon and Scanner modules feature split views (graph/table), Exploitation Toolkit uses dual-pane request/response, and the Report Generator offers a markdown editor with live preview. All tables are sortable/filterable, and modals are used for settings and plugin management. Accessibility and keyboard navigation are prioritized."\n}'}",
